# ──────────────────────────────────────────────────────────────────────
# Caddy — auto-SSL reverse proxy + rate limiting + DNS-01 ACME
#
# DNS-01 ACME via DuckDNS plugin → SSL certificate get karne ke liye
# port 80 ki zaroorat NAHI. Aapke PC pe agar port 80/443 koi aur project
# pehle se use kar raha ho, ye stack alternative ports pe chal sakta hai
# bina SSL toot-e — DuckDNS API se DNS record bana ke verify hota hai.
#
# Routes:
#   /api/*, /health, /ws/*, /r/*, /t/*  →  backend:8001
#   /*                                   →  frontend:80
# ──────────────────────────────────────────────────────────────────────

{
    email {$LE_EMAIL}

    # DNS-01 challenge via DuckDNS — no port 80 dependency
    acme_dns duckdns {$DUCKDNS_TOKEN}

    order rate_limit before basicauth

    servers {
        timeouts {
            read_body   60s
            read_header 10s
            write       0
            idle        120s
        }
        max_header_size 64KB
    }
}

{$BACKEND_DOMAIN} {
    @auth_paths path /api/auth/login /api/auth/register /api/admin/login /api/sub-users/login
    rate_limit @auth_paths {
        zone auth_burst {
            key    {remote_host}
            events 10
            window 10s
        }
    }

    rate_limit {
        zone global_burst {
            key    {remote_host}
            events 600
            window 60s
        }
    }

    request_body {
        max_size 100MB
    }

    @backend {
        path /api/* /health /ws/* /r/* /t/*
    }
    reverse_proxy @backend backend:8001 {
        transport http {
            read_timeout 600s
            write_timeout 600s
            dial_timeout 10s
            response_header_timeout 600s
        }
        health_uri      /health
        health_interval 15s
        health_timeout  5s
        health_status   2xx

        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
        header_up Host {host}

        lb_try_duration 5s
        lb_try_interval 250ms
    }

    reverse_proxy frontend:80 {
        transport http {
            read_timeout 120s
        }
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
        header_up Host {host}
    }

    encode zstd gzip

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        -Server
        X-Frame-Options "SAMEORIGIN"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        X-XSS-Protection "1; mode=block"
    }

    log {
        output stdout
        format console
        level INFO
    }
}
