# ──────────────────────────────────────────────────────────────────────
# Caddy — auto-SSL reverse proxy + rate limiting
# Routes:
#   /api/*, /health, /ws/*, /r/*, /t/*  →  backend:8001  (FastAPI)
#   /*                                   →  frontend:80   (nginx static)
# Built with mholt/caddy-ratelimit plugin (deployment/caddy/Dockerfile).
# ──────────────────────────────────────────────────────────────────────

{
    email {$LE_EMAIL}
    order rate_limit before basicauth

    servers {
        timeouts {
            read_body   60s
            read_header 10s
            write       0          # unlimited (long SSE / RUT streams)
            idle        120s
        }
        max_header_size 64KB
    }
}

{$BACKEND_DOMAIN} {
    # ── Rate limiting ────────────────────────────────────────────────
    @auth_paths path /api/auth/login /api/auth/register /api/admin/login /api/sub-users/login
    rate_limit @auth_paths {
        zone auth_burst {
            key    {remote_host}
            events 10
            window 10s
        }
    }

    rate_limit {
        zone global_burst {
            key    {remote_host}
            events 600
            window 60s
        }
    }

    # ── Upload / body size ───────────────────────────────────────────
    request_body {
        max_size 100MB
    }

    # ── Backend routes ───────────────────────────────────────────────
    # /api/* , /health , /ws/* , /r/* , /t/*  go to FastAPI.
    @backend {
        path /api/* /health /ws/* /r/* /t/*
    }
    reverse_proxy @backend backend:8001 {
        transport http {
            read_timeout 600s
            write_timeout 600s
            dial_timeout 10s
            response_header_timeout 600s
        }
        health_uri      /health
        health_interval 15s
        health_timeout  5s
        health_status   2xx

        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
        header_up Host {host}

        lb_try_duration 5s
        lb_try_interval 250ms
    }

    # ── Frontend (everything else) ───────────────────────────────────
    # nginx container serving the React production build.
    reverse_proxy frontend:80 {
        transport http {
            read_timeout 120s
        }
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
        header_up Host {host}
    }

    # ── Compression ──────────────────────────────────────────────────
    encode zstd gzip

    # ── Security headers ─────────────────────────────────────────────
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        -Server
        X-Frame-Options "SAMEORIGIN"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        X-XSS-Protection "1; mode=block"
    }

    # ── Access log ───────────────────────────────────────────────────
    log {
        output stdout
        format console
        level INFO
    }
}
